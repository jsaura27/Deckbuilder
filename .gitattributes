# Normalize line endings and classify common Unity file types
* text=auto eol=lf

# Unity YAML/text assets
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.dll binary

