# ============= Unity Project Git Ignore ==================
# This .gitignore is based on the official Unity template with a few practical additions.
# Keep: Assets/, ProjectSettings/, Packages/ (manifest.json + packages-lock.json), .editorconfig, README, etc.
# Ignore: Generated caches, local user prefs, build outputs, IDE temp files.

# ----------------------------------------------------------------------------
# Core Unity generated folders (HUGE, regenerate automatically)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/
Recordings/

# Unity cache / performance artifacts
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
[Dd]erivedDataCache/
# Crash / diagnostics
[Cc]rashReports/

# Scene / build reports & interim files
*.buildreport
*.pidb
*.suo
*.user
*.userprefs
*.booproj
*.svd
*.pdb.meta

# Visual Studio / C# solution artifacts (auto-generated by Unity)
*.csproj
*.unityproj
*.sln
*.sln.dotsettings
*.vcxproj*
*.pidb.meta
*.mdb
*.opendb
*.VC.db
.vs/

# Rider / JetBrains
.idea/
*.sln.iml

# VSCode workspace settings (optional to ignore if you use shared settings)
.vscode/

# Package manager downloaded stuff (already inside Library but just in case)
/[Pp]ackages/PackageCache/

# Addressables / Generated if used
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Auto-generated Animation stuff
*.anim.meta

# Generated ShaderCache
[Ss]haderCache/

# Platform specific
[Bb]uilds_*/

# Lightmaps / GI cache (in Library but if custom path)
LightmapSnapshot.asset

# Unity Hub / Editor logs
*.unitypackage

# Optional: Ignore local test results if any temp folder used
TestResults*/

# Yarn / Node (if any tooling scripts - adjust if you actually use these)
node_modules/

# Python virtual environments (if any tooling scripts)
venv/
.env

# OS junk
Thumbs.db
.DS_Store
ehthumbs.db
Icon?

# Archives / backups
*.zip
*.tar.gz
*.rar

# ============= KEEP THESE DIRECTORIES =============
# Assets/  (your actual source assets)
# Packages/ (manifest.json & packages-lock.json)
# ProjectSettings/ (project configuration)
# ================================================

# If you use Git LFS for large binaries, list patterns below (commented examples):
# *.psd
# *.fbx
# *.wav
# *.mp4

# End of file
