{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Status Effects Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "stacking": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["stack", "refresh", "override"] },
        "maxStacks": { "type": "integer", "minimum": 1 }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "duration": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["turns", "seconds"] },
        "value": { "type": "number", "minimum": 0 }
      },
      "required": ["type","value"],
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "params": { "type": "object" }
        },
        "required": ["type"],
        "additionalProperties": false
      }
    },
    "sourceWhitelist": {
      "type": "array",
      "items": { "type": "string", "enum": ["card","equipment","blessing","ability","system"] }
    }
  },
  "required": ["id","name","stacking","duration","effects"],
  "additionalProperties": false
}
