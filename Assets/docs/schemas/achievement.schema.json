{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Achievement",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "visibility": { "type": "string", "enum": ["public", "hidden"] },
    "criteria": {
      "type": "object",
      "properties": {
        "event": { "type": "string" },
        "operator": { "type": "string", "enum": ["gte","lte","eq","count"] },
        "threshold": { "type": "number" }
      },
      "required": ["event"]
    },
    "rewards": {
      "type": "array",
      "items": { "type": "object" }
    },
    "version": { "type": "string" }
  },
  "required": ["id","title","criteria"]
}
