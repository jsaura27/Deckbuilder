{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/changes-log.schema.json",
  "title": "Changes Log",
  "type": "object",
  "required": ["task", "timestamp", "filesCreated", "filesEdited", "buildStatus"],
  "properties": {
    "task": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "planFilesValidated": {"type": "boolean"},
    "planMatch": {"type": "boolean"},
    "filesCreated": {
      "type": "array",
      "items": {"type": "string"}
    },
    "filesEdited": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context", "decision"],
        "properties": {
          "context": {"type": "string"},
          "decision": {"type": "string"},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "buildStatus": {"type": "string", "enum": ["success", "error"]},
    "buildOutput": {"type": ["string", "null"]},
    "tests": {
      "type": "object",
      "properties": {
        "executed": {"type": "boolean"},
        "summary": {"type": ["string", "null"]},
        "failures": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
